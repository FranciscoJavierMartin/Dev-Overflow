meta {
  name: Get answers by question
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/answers?questionId={{questionId}}&page=1&pageSize=15&query=te
  body: none
  auth: inherit
}

params:query {
  questionId: {{questionId}}
  page: 1
  pageSize: 15
  query: te
}

settings {
  encodeUrl: true
  timeout: 0
}
