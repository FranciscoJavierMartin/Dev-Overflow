meta {
  name: Get answers by question
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/answers?questionId={{questionId}}&sort=latest
  body: none
  auth: inherit
}

params:query {
  questionId: {{questionId}}
  sort: latest
}

vars:post-response {
  answerId: res.body.answers[0].id
}

settings {
  encodeUrl: true
  timeout: 0
}
